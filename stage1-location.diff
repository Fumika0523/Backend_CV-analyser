diff --git a/utils/jobLocation.js b/utils/jobLocation.js
new file mode 100644
index 0000000..11a9e68
--- /dev/null
+++ b/utils/jobLocation.js
@@ -0,0 +1,87 @@
+const LOCATION_TYPES = ["city", "county", "region", "country"];
+const WORK_MODES = ["Office", "Hybrid", "Remote"];
+const LOCATION_FIELDS = [
+  "city", "country", "county", "region", "locationType",
+  "displayName", "providerPlaceId",
+];
+
+const hasText = (value) => typeof value === "string" && value.trim() !== "";
+const result = (errors) => ({ valid: errors.length === 0, errors });
+
+/**
+ * Future location policy, intentionally not used by controllers in Stage 1.
+ * Unlike today's schema, Remote locations may omit city when an explicit
+ * county/region/country type is supplied. A metropolitan area uses type city
+ * and its name in city; no provider lookup or geographical verification occurs.
+ * Legacy objects without locationType, and "city, country" strings, are
+ * treated as city locations. Inputs are never mutated.
+ */
+const validateJobLocation = (location, workMode) => {
+  if (!WORK_MODES.includes(workMode)) {
+    return result(["Work mode must be Office, Hybrid or Remote."]);
+  }
+
+  if (typeof location === "string") {
+    const parts = location.split(",").map((part) => part.trim());
+    if (parts.length !== 2 || parts.some((part) => !part)) {
+      return result(["Legacy location must contain city and country."]);
+    }
+    location = { city: parts[0], country: parts[1] };
+  }
+
+  if (!location || typeof location !== "object" || Array.isArray(location)) {
+    return result(["A location with a country is required."]);
+  }
+
+  const errors = [];
+  for (const field of LOCATION_FIELDS) {
+    if (location[field] !== undefined && typeof location[field] !== "string") {
+      errors.push(`Location ${field} must be a string.`);
+    }
+  }
+
+  if (!hasText(location.country)) {
+    errors.push("Location country is required.");
+  }
+
+  // Do not guess county or region for old records that lack a type.
+  const locationType = location.locationType === undefined
+    ? "city"
+    : location.locationType;
+
+  if (!LOCATION_TYPES.includes(locationType)) {
+    errors.push("Location type must be city, county, region or country.");
+  } else {
+    if (workMode !== "Remote" && locationType !== "city") {
+      errors.push("Office and Hybrid jobs require a city or metropolitan area.");
+    }
+
+    if (locationType !== "country" && !hasText(location[locationType])) {
+      errors.push(`Location ${locationType} is required.`);
+    }
+  }
+
+  return result(errors);
+};
+
+/**
+ * For future plain controller update payloads (not MongoDB update operators).
+ * An omitted field keeps its stored value. An explicitly supplied location
+ * replaces the location, matching the current controller's update semantics.
+ * Unrelated edits must not force old jobs to adopt the new location policy.
+ */
+const validateJobLocationUpdate = (existingJob, updates) => {
+  const changesLocation = Object.hasOwn(updates, "location");
+  const changesWorkMode = Object.hasOwn(updates, "workMode");
+
+  if (!changesLocation && !changesWorkMode) {
+    return result([]);
+  }
+
+  return validateJobLocation(
+    changesLocation ? updates.location : existingJob.location,
+    changesWorkMode ? updates.workMode : existingJob.workMode
+  );
+};
+
+module.exports = { validateJobLocation, validateJobLocationUpdate };
diff --git a/tests/jobLocation.test.js b/tests/jobLocation.test.js
new file mode 100644
index 0000000..ad9a665
--- /dev/null
+++ b/tests/jobLocation.test.js
@@ -0,0 +1,140 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  validateJobLocation,
+  validateJobLocationUpdate,
+} = require("../utils/jobLocation");
+
+const country = "United Kingdom";
+const cityLocation = { city: "London", country, locationType: "city" };
+
+for (const workMode of ["Office", "Hybrid", "Remote"]) {
+  test(`${workMode} accepts city and metropolitan area locations`, () => {
+    for (const city of ["London", "Greater Manchester"]) {
+      assert.deepEqual(
+        validateJobLocation({ ...cityLocation, city }, workMode),
+        { valid: true, errors: [] }
+      );
+    }
+  });
+
+  test(`${workMode} accepts legacy objects and city/country strings`, () => {
+    for (const location of [
+      { city: "London", country },
+      ` London , ${country} `,
+    ]) {
+      assert.equal(validateJobLocation(location, workMode).valid, true);
+    }
+  });
+}
+
+for (const locationType of ["county", "region", "country"]) {
+  const location = {
+    country,
+    locationType,
+    ...(locationType === "county" ? { county: "Kent" } : {}),
+    ...(locationType === "region" ? { region: "South East England" } : {}),
+  };
+
+  test(`Remote accepts ${locationType} without city`, () => {
+    assert.equal(validateJobLocation(location, "Remote").valid, true);
+  });
+
+  for (const workMode of ["Office", "Hybrid"]) {
+    test(`${workMode} rejects ${locationType} even with a city present`, () => {
+      const validation = validateJobLocation({ ...location, city: "London" }, workMode);
+      assert.equal(validation.valid, false);
+      assert.ok(validation.errors.includes(
+        "Office and Hybrid jobs require a city or metropolitan area."
+      ));
+    });
+  }
+}
+
+test("missing, malformed and incomplete locations fail without throwing", () => {
+  for (const location of [
+    undefined, null, false, 123, [], {}, "", "London", "London,",
+    ",United Kingdom", "London, England, United Kingdom",
+    { city: "London" }, { country }, { city: " ", country },
+    { city: "London", country: " " },
+    { city: "London", country: 123 },
+    { city: ["London"], country },
+    { country, locationType: "county" },
+    { country, locationType: "region", region: " " },
+    { country, locationType: "country", displayName: {} },
+    { country, locationType: "country", providerPlaceId: 123 },
+    { ...cityLocation, county: [] },
+    { ...cityLocation, locationType: "metropolitan" },
+    { ...cityLocation, locationType: "" },
+    { ...cityLocation, locationType: null },
+  ]) {
+    const validation = validateJobLocation(location, "Remote");
+    assert.equal(validation.valid, false, JSON.stringify(location));
+    assert.ok(validation.errors.length > 0);
+  }
+});
+
+test("unknown or missing work modes fail", () => {
+  for (const workMode of [undefined, null, "", "remote", "On-site"]) {
+    assert.equal(validateJobLocation(cityLocation, workMode).valid, false);
+  }
+});
+
+test("metadata is optional and validation does not mutate inputs", () => {
+  const location = Object.freeze({
+    ...cityLocation,
+    city: " London ",
+    county: "",
+    region: "Greater London",
+    displayName: "London, United Kingdom",
+    providerPlaceId: "provider-123",
+  });
+  assert.deepEqual(validateJobLocation(location, "Office"), { valid: true, errors: [] });
+  assert.equal(location.city, " London ");
+});
+
+test("unrelated edits skip location validation for incomplete legacy records", () => {
+  const existingJob = { location: null, workMode: "Office" };
+  for (const updates of [{}, { title: "New title" }, { salary: "50000", county: "Kent" }]) {
+    assert.deepEqual(validateJobLocationUpdate(existingJob, updates), {
+      valid: true, errors: [],
+    });
+  }
+});
+
+test("location edits use stored work mode and replace rather than merge location", () => {
+  const existingJob = { location: cityLocation, workMode: "Office" };
+  assert.equal(validateJobLocationUpdate(existingJob, {
+    location: { ...cityLocation, city: "Manchester" },
+  }).valid, true);
+  for (const location of [undefined, null, { city: "Manchester" }, { country, locationType: "country" }]) {
+    assert.equal(validateJobLocationUpdate(existingJob, { location }).valid, false);
+  }
+});
+
+test("work mode edits validate stored location against the new mode", () => {
+  const remoteJob = { location: { country, locationType: "country" }, workMode: "Remote" };
+  assert.equal(validateJobLocationUpdate(remoteJob, { workMode: "Hybrid" }).valid, false);
+  assert.equal(validateJobLocationUpdate(remoteJob, { workMode: "Office" }).valid, false);
+  assert.equal(validateJobLocationUpdate(remoteJob, { workMode: undefined }).valid, false);
+  assert.equal(validateJobLocationUpdate({ location: cityLocation, workMode: "Office" }, {
+    workMode: "Remote",
+  }).valid, true);
+});
+
+test("simultaneous edits validate the submitted pair without mutating either input", () => {
+  const existingJob = Object.freeze({ location: cityLocation, workMode: "Office" });
+  const updates = Object.freeze({
+    location: Object.freeze({ country, locationType: "country" }),
+    workMode: "Remote",
+  });
+  assert.equal(validateJobLocationUpdate(existingJob, updates).valid, true);
+  assert.equal(existingJob.workMode, "Office");
+  assert.equal(updates.location.locationType, "country");
+});
+
+test("echoed legacy location remains valid when a job is edited", () => {
+  const existingJob = { location: { city: "London", country }, workMode: "Office" };
+  assert.equal(validateJobLocationUpdate(existingJob, { location: existingJob.location }).valid, true);
+  assert.equal(validateJobLocationUpdate(existingJob, { workMode: "Hybrid" }).valid, true);
+});
diff --git a/tests/jobModel.test.js b/tests/jobModel.test.js
new file mode 100644
index 0000000..4be46f8
--- /dev/null
+++ b/tests/jobModel.test.js
@@ -0,0 +1,75 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const mongoose = require("mongoose");
+const Job = require("../Model/jobModel");
+
+// In-memory validation only: no database connection or writes.
+const makeJob = (location) => new Job({
+  companyId: new mongoose.Types.ObjectId(),
+  createdBy: new mongoose.Types.ObjectId(),
+  title: "Developer",
+  education: "Degree",
+  experience: "2 years",
+  postedByName: "Test Recruiter",
+  roleSummary: "Build software",
+  compensationBenefits: "Pension",
+  category: "IT & Software",
+  industry: "Technology",
+  applicationEndDate: new Date("2030-01-01"),
+  salary: "50000",
+  location,
+});
+
+test("legacy city/country documents need no new location fields", () => {
+  const job = makeJob({ city: "London", country: "United Kingdom" });
+  assert.equal(job.validateSync(), undefined);
+  for (const field of ["county", "region", "locationType", "displayName", "providerPlaceId"]) {
+    assert.equal(job.location[field], undefined);
+  }
+});
+
+test("all optional nested location fields are retained", () => {
+  const location = {
+    city: "London",
+    country: "United Kingdom",
+    county: "Greater London",
+    region: "England",
+    locationType: "city",
+    displayName: "London, United Kingdom",
+    providerPlaceId: "provider-123",
+  };
+  const job = makeJob(location);
+  assert.equal(job.validateSync(), undefined);
+  assert.deepEqual(job.toObject().location, location);
+});
+
+test("locationType accepts only the four planned types", () => {
+  for (const locationType of ["city", "county", "region", "country"]) {
+    const job = makeJob({ city: "London", country: "United Kingdom", locationType });
+    assert.equal(job.validateSync(), undefined);
+  }
+  const invalidJob = makeJob({ city: "London", country: "United Kingdom", locationType: "state" });
+  assert.equal(invalidJob.validateSync().errors["location.locationType"].kind, "enum");
+});
+
+test("city and country remain required, including Remote jobs", () => {
+  for (const location of [undefined, {}, { country: "United Kingdom", locationType: "country" }, { city: "London" }]) {
+    const job = makeJob(location);
+    job.workMode = "Remote";
+    const error = job.validateSync();
+    assert.ok(error);
+    assert.ok(error.errors["location.city"] || error.errors["location.country"]);
+  }
+});
+
+test("top-level county and state stay separate from nested location fields", () => {
+  const job = makeJob({ city: "London", country: "United Kingdom", county: "Nested county" });
+  assert.equal(job.county, "");
+  assert.equal(job.state, "");
+  job.county = "Existing county";
+  job.state = "Existing state";
+  assert.equal(job.validateSync(), undefined);
+  assert.equal(job.county, "Existing county");
+  assert.equal(job.state, "Existing state");
+  assert.equal(job.location.county, "Nested county");
+});
